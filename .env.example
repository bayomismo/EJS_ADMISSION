# EJS Admission — environment template (T1.4)
# Copy to `.env` for local development. NEVER commit real values.
# Production values live only in the Vercel project settings.

# PostgreSQL connection string (the Prisma schema uses provider = "postgresql";
# SQLite `file:` URLs do NOT work). Local test example:
DATABASE_URL="postgresql://ejs_test:CHANGE_ME@127.0.0.1:54329/ejs_test?sslmode=disable"

# NextAuth — generate with: openssl rand -base64 48  (min 32 chars; rejected in production if short)
NEXTAUTH_SECRET="CHANGE_ME_generate_a_random_value_of_at_least_32_chars"
NEXTAUTH_URL="http://localhost:3000"

# Vercel Cron bearer token for /api/cron/retention (any random value locally)
CRON_SECRET="CHANGE_ME"

# Optional: Vercel Blob token. Leave empty to use local file storage (var/ejs-uploads).
BLOB_READ_WRITE_TOKEN=""

# Optional
# EJS_UPLOAD_DIR=""
# PRISMA_SLOW_QUERY_MS="200"
# ALLOW_PROD_SEED="0"
